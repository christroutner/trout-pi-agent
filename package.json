{
	"name": "trout-pi-agent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Pi coding agent launcher with pinned extensions and pi-backup skills",
	"scripts": {
		"start": "node --import tsx ./src/index.ts",
		"rpc": "node --import tsx ./src/index.ts rpc",
		"build": "tsc -p tsconfig.json",
		"start:dist": "node dist/index.js"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.6.0",
		"@earendil-works/pi-coding-agent": "1.6.0",
		"dotenv": "18.0.10",
		"mcp-interactive-terminal": "1.0.9",
		"tsx": "4.23.15"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"typescript": "7.0.2"
	}
}
